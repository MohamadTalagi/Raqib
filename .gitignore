# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node / Flutter
node_modules/
build/
.dart_tool/
.flutter-plugins*

# OS
.DS_Store
Thumbs.db

# Real local secrets (INTENTIONAL lab secrets are committed on purpose)
.env
*.local

# Runtime-generated raw evidence output
lab/document-store/raw/
document-store/pcap/*.pcap
.claude/worktrees/
.superpowers/

# Lab-generated artifacts (regenerable, keep repo lean)
lab/certs/*.key
lab/certs/*.crt
lab/certs/*.csr
lab/certs/*.srl
lab/mqtt/secure/passwd
lab/auditor/worker/firmware/output/

# Must never be a real file: device_validation.py is baked into the
# auditor-worker image from lab/auditor/api/device_validation.py (single
# source of truth) and reached via PYTHONPATH=/work, never bind-mounted at
# this path - if one shows up here (e.g. as a side effect of an ad hoc
# Docker file-bind-mount test run), it silently shadows the real module and
# breaks the worker (docs/errors/027).
lab/auditor/worker/device_validation.py

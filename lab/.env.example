# Device identity
DEVICE_ID=device-insecure
DEVICE_VENDOR=AcmeCam
DEVICE_MODEL=AC-100
DEVICE_MAC=AA:BB:CC:00:11:22
FIRMWARE_VERSION=1.0.0-old

# Transport / TLS
TRANSPORT=http            # http | https
TLS_PROFILE=none          # none | weak | strong
TLS_KEYFILE=
TLS_CERTFILE=

# Credentials
CRED_MODE=default         # default | strong
ADMIN_USER=admin
ADMIN_PASS=admin

# API key exposure
EXPOSE_API_KEY=true
API_KEY=sk-insecure-hardcoded-key-000111222

# Admin endpoint auth
REQUIRE_ADMIN_AUTH=false

# Logging
LOGGING_MODE=off          # off | basic | security

# MQTT
MQTT_HOST=mqtt-broker-insecure
MQTT_PORT=1883
MQTT_TLS=false
MQTT_CA_CERT=

# Privacy doc
PRIVACY_DOC_PATH=docs/privacy_insecure.md

# Auditor (Phases 6-8)
AUDITOR_API_URL=http://auditor-api:8000

# Database (Phases 6-8)
DATABASE_URL=postgresql://auditor:auditor-lab-pw@auditor-database:5432/auditor
POSTGRES_DB=auditor
POSTGRES_USER=auditor
POSTGRES_PASSWORD=auditor-lab-pw

# AI-Assisted Remediation (IoTGuard Stage 07) - free tier, no billing
# attached. Get a key at https://aistudio.google.com ("Get API key").
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

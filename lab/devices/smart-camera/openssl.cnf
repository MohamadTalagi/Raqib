openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
# SECLEVEL=0 allows the intentionally weak 1024-bit/SHA-1 cert used by
# device-partial to model a legacy/insecure TLS configuration. Modern
# OpenSSL's default SECLEVEL=2 refuses to even load such a key
# (EE_KEY_TOO_SMALL) -- a real vulnerable legacy device would happily
# serve it, so we relax the policy to let the lab actually reproduce
# that posture. device-hardened is unaffected: its security comes from
# using a genuinely strong 2048-bit/SHA-256 key, not from this gate.
CipherString = DEFAULT@SECLEVEL=0
